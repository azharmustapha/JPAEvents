# Public Supabase configuration: supply before next build (also for Docker build args).
# Use a publishable/anonymous key only. Never put a service-role key here.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Use true only with supabase/shared-project.sql and shared-storage.sql.
# This isolates JPAEvents tables/functions when another app shares this project.
NEXT_PUBLIC_JPAEVENTS_SHARED_PROJECT=false

# Optional test-only settings belong in a git-ignored .env.test file.
# TEST_DATABASE_URL=postgresql://... (disposable migrated Supabase project only)
# ALLOW_DATABASE_TESTS=true
# TEST_APP_URL=http://localhost:3000
# TEST_SUPABASE_URL=https://test-project.supabase.co
# TEST_SUPABASE_ANON_KEY=public-test-key
# TEST_ADMIN_EMAIL=approved-test-admin@example.gov.my
# TEST_ADMIN_PASSWORD=configure-locally
# TEST_MEMBER_EMAIL=non-admin-test-user@example.gov.my
# TEST_MEMBER_PASSWORD=configure-locally
